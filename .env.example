# Splunk 流量看板 - 环境变量样例
#
# 所有配置都可以在网页端完成（首次访问的初始化向导 / 右上角 ⚙ 设置），
# 网页保存的配置存放在项目根目录 config.json（已被 .gitignore 忽略）。
#
# 注意：在这里（.env 或系统环境变量）设置的值【优先于】网页配置，
# 并且对应的设置页字段会变为只读。想完全用网页管理配置的话，
# 保持本文件为空即可（直接复制成 .env 也无需取消任何注释）。

# ---- Splunk 连接（也可在网页向导中配置）----
# 管理端口 8089（REST API），不是网页控制台的 8000 端口
#SPLUNK_API_URL=https://splunk.example.com:8089
# 认证方式二选一：Bearer Token（推荐）或 用户名/密码
#SPLUNK_TOKEN=
#SPLUNK_USERNAME=
#SPLUNK_PASSWORD=
# 自签名证书无法通过校验时保持 false
#SPLUNK_VERIFY_CERTS=false

# ---- 看板服务 ----
# 监听地址；0.0.0.0 = 局域网可访问（挂壁大屏场景），注意配置接口无鉴权
#DASHBOARD_HOST=127.0.0.1
#DASHBOARD_PORT=8091
# Splunk 查询结果缓存秒数
#DASHBOARD_CACHE_TTL=300
# 置 1 = 演示数据模式（不查询 Splunk，用于预览 UI）
#DASHBOARD_MOCK=0
# 跟踪的索引列表（JSON 数组）；留空 = 自动发现模式（见下方过滤模式）
#TRAFFIC_INDEXES=[]
# 自动发现模式的过滤（JSON 数组，逗号分隔的通配符）：
# 包含模式留空 = 全部；排除模式匹配的索引不跟踪（内部 _* 始终排除）
#TRAFFIC_INDEX_INCLUDE=[]
#TRAFFIC_INDEX_EXCLUDE=[]
# 后台索引自动重扫间隔（分钟，0 = 关闭新索引检测）
#INDEX_RESCAN_MINUTES=10
